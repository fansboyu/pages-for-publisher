PORT=3000
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://publisher:change-me@postgres:5432/publisher
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_DAYS=30
GITHUB_TOKEN=
# 仅由 Worker 使用的 GitHub 出站 HTTP/HTTPS 代理；不要提交真实账号或密码。
GIT_PROXY_URL=http://username:password@proxy.example.com:3128
GIT_AUTHOR_NAME=Static Publisher Bot
GIT_AUTHOR_EMAIL=publisher@clickadwave.org
WORK_ROOT=/data/work
UPLOAD_ROOT=/data/uploads
PUBLIC_API_BASE_URL=https://api-v2.clickadwave.org
CORS_ORIGIN=https://admin.clickadwave.org
