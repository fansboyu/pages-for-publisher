# 正式试点配置。生产 Compose 从 .env 读取；不要提交实际 .env。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgres://sitecontrol:填写密码@127.0.0.1:55432/sitecontrol
REDIS_URL=redis://:填写密码@127.0.0.1:16379/0
PORT=4418
HOST=127.0.0.1
DATA_ROOT=./storage/pilot
PUBLIC_BASE_URL=https://control.example.cn
DEMO_MODE=false
BOOTSTRAP_ADMIN_PASSWORD=
COOKIE_SECURE=true
BUILD_CONCURRENCY=2
BUILD_QUEUE_NAME=website-builds-v2
PACKAGE_MAX_COMPRESSED_MB=128
PACKAGE_MAX_UNPACKED_MB=512
PACKAGE_MAX_FILES=20000
# 默认只允许从当前项目的父目录导入；生产容器设置为 /imports。
# TEMPLATE_IMPORT_ROOT=/imports
# 切换驱动不会迁移旧文件；先搬迁历史归档/素材，参阅 docs/网站回滚与OSS配置.md。
STORAGE_DRIVER=local
# 私有归档可独立启用OSS；留空时跟随STORAGE_DRIVER。
ARCHIVE_STORAGE_DRIVER=
# 两个不同Bucket需位于同一区域，归档Bucket保持私有。
OSS_REGION=oss-cn-shanghai
OSS_MEDIA_BUCKET=
OSS_ARCHIVE_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# STS三项凭据需配套填写；当前无自动续期，到期前更新并重建API/Worker。
OSS_STS_TOKEN=
# 图片URL根地址，代码自动追加 media/sites/...；使用稳定HTTPS域名。
MEDIA_PUBLIC_BASE_URL=https://img.example.cn
# 模板上传限额（独立于网站发布包）
TEMPLATE_MAX_COMPRESSED_MB=64
TEMPLATE_MAX_UNPACKED_MB=256
TEMPLATE_MAX_FILES=10000
# DeepSeek 文章生成（仅服务端读取）
AI_TEXT_BASE_URL=https://api.deepseek.com/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
AI_TEXT_MAX_TOKENS=8192
# 阿里云百炼图像生成：地区/API Key 必须配套；北京默认域名可替换为业务空间专属域名
ALIYUN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
ALIYUN_IMAGE_API_KEY=
ALIYUN_IMAGE_MODEL=
# text2image 适用于万相文生图 V1/V2；multimodal 适用于 wan2.6/wan2.7 图像生成异步接口
ALIYUN_IMAGE_API_STYLE=text2image
ALIYUN_IMAGE_SIZE=1280*720
AI_INLINE_IMAGE_COUNT=2
AI_IMAGE_TIMEOUT_MS=300000
ALIYUN_IMAGE_POLL_INTERVAL_MS=10000
# Optional generic JSON webhook for build/deployment/agent status alerts.
ALERT_WEBHOOK_URL=
ALERT_POLL_MS=60000
ALERT_COOLDOWN_MINUTES=60
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=14

# Optional SSH provisioning. Enable production profile only after configuring these.
# Local launcher generates an ephemeral internal token; no customer credentials belong here.
PROVISIONER_URL=
PROVISIONER_TOKEN=
PROVISIONER_ALLOWED_CIDRS=
# Comma-separated public IPv4 /32 or /24..32 networks; empty denies all targets.
# Example format only: 203.0.113.10/32
# Must have the same HTTPS origin as PUBLIC_BASE_URL; never point local tokens at another control plane.
PROVISIONER_CONTROL_URL=
