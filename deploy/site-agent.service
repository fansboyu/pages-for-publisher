[Unit]
Description=Website Deployment Agent
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=simple
User=site-agent
Group=caddy
WorkingDirectory=/opt/site-control
ExecStart=/usr/bin/node /opt/site-control/agent/agent.mjs /etc/site-agent/agent.json
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/site-agent

[Install]
WantedBy=multi-user.target
