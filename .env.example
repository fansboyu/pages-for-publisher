# node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=4318
PUBLIC_BASE_URL=http://127.0.0.1:4318
STORAGE_DRIVER=local
# STORAGE_DRIVER=oss 时下列配置必填；不要使用阿里云主账号密钥。
OSS_REGION=oss-cn-shanghai
OSS_MEDIA_BUCKET=
OSS_ARCHIVE_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 临时凭据场景须同时填写并在到期前由运维刷新。
OSS_STS_TOKEN=
MEDIA_PUBLIC_BASE_URL=https://img.example.cn
# AI 创作（后端 API 与 Worker 启动环境；密钥勿放进前端或提交）
AI_TEXT_BASE_URL=https://api.deepseek.com/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
AI_TEXT_MAX_TOKENS=8192
ALIYUN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
ALIYUN_IMAGE_API_KEY=
ALIYUN_IMAGE_MODEL=
ALIYUN_IMAGE_API_STYLE=text2image
ALIYUN_IMAGE_SIZE=1280*720
AI_INLINE_IMAGE_COUNT=2
AI_IMAGE_TIMEOUT_MS=300000
ALIYUN_IMAGE_POLL_INTERVAL_MS=10000
ALERT_WEBHOOK_URL=
ALERT_POLL_MS=60000
ALERT_COOLDOWN_MINUTES=60
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=14

# Optional SSH provisioning. Enable production profile only after configuring these.
# Local launcher generates an ephemeral internal token; no customer credentials belong here.
PROVISIONER_URL=
PROVISIONER_TOKEN=
PROVISIONER_ALLOWED_CIDRS=
# Comma-separated public IPv4 /32 or /24..32 networks; empty denies all targets.
# Example format only: 203.0.113.10/32
# Must have the same HTTPS origin as PUBLIC_BASE_URL; never point local tokens at another control plane.
PROVISIONER_CONTROL_URL=
